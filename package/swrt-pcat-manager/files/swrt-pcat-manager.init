#!/bin/sh /etc/rc.common
START=45
STOP=89
USE_PROCD=1

start_service() {
    [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'ariaboard,photonicat' ] || return 1
    [ -c /dev/ttyS4 ] || return 1
    if pidof pcat-mgr pcat-manager >/dev/null 2>&1; then
        logger -t swrt-power 'Another MCU owner is active; refusing to start'
        return 1
    fi
    procd_open_instance
    procd_set_param command /usr/sbin/swrt-pcat-manager --distro
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Ordinary service restarts use upstream's watchdog-disarm signal first.
    # System shutdown retains the official PMU shutdown/reboot handshake.
    if [ "${SWRT_SYSTEM_SHUTDOWN:-0}" = 0 ]; then
        procd_send_signal swrt-pcat-manager '*' USR1
        sleep 2
    fi
}

shutdown() {
    SWRT_SYSTEM_SHUTDOWN=1
    stop
}
