#!/bin/sh /etc/rc.common
START=94
STOP=11
USE_PROCD=1

start_service() {
    [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'ariaboard,photonicat' ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/swrt-wlmb-battery
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
