#!/bin/sh
uci set luci.themes.Apollo='/luci-static/apollo'
# 保留配置升级时，清理已无对应资源的 Argon 菜单项。
if [ ! -d /www/luci-static/argon ]; then
    for key in Argon argon; do
        if [ "$(uci -q get "luci.themes.$key")" = /luci-static/argon ]; then
            uci -q delete "luci.themes.$key"
        fi
    done
fi
case "$(uci -q get luci.main.mediaurlbase)" in
    ''|/luci-static/argon|/luci-static/bootstrap) uci set luci.main.mediaurlbase='/luci-static/apollo' ;;
esac
uci commit luci
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*
exit 0
