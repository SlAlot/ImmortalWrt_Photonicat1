 Apollo theme by SlAlot.
 LuCI header integration derived from the Apache-2.0 LuCI Bootstrap template.
 Copyright 2008 Steven Barth; 2012 David Menting; 2008-2022 Jo-Philipp Wich.
-#}
{%
    import { getuid, getspnam } from 'luci.core';
    const boardinfo = ubus.call('system', 'board');
    http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="auto">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="color-scheme" content="light dark">
        <meta name="darkreader-lock">
        <title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
        <script>try{var npMode=localStorage.getItem('network-panel-appearance');if(['auto','light','dark'].includes(npMode))document.documentElement.dataset.theme=npMode;}catch(e){}</script>
        <link rel="stylesheet" href="{{ media }}/compat.css?v=1.0.0-r3">
        <link rel="stylesheet" href="{{ media }}/theme.css?v=1.0.0-r3">
        {% if (node?.css): %}<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">{% endif %}
        {% if (css): %}<style>{{ css }}</style>{% endif %}
        <script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
        <script src="{{ resource }}/cbi.js"></script>
    </head>
    <body class="np-theme lang_{{ dispatcher.lang }}{{ blank_page ? ' npt-login' : '' }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
        {% if (!blank_page): %}
        <a class="npt-skip" href="#maincontent">跳转到主要内容</a>
        <header class="npt-topbar">
            <button id="npt-menu-toggle" type="button" class="npt-icon-button" aria-label="打开导航菜单" aria-controls="npt-navigation" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
            <a class="npt-brand" href="{{ dispatcher.build_url('admin') }}"><span class="npt-brand-mark"><img src="{{ media }}/logo.png" alt=""></span><span>Apollo<small>{{ striptags(boardinfo.hostname ?? '?') }}</small></span></a>
            <span id="npt-page-title" class="npt-page-title">{{ _(dispatched?.title ?? '设备管理') }}</span>
            <div class="npt-topbar-actions">
                <a id="npt-battery" class="npt-battery is-unknown" href="{{ dispatcher.build_url('admin/system/swrt-power') }}" aria-label="打开光影猫管理"><span>—</span></a>
                <div id="indicators"></div>
                <button id="npt-appearance" type="button" class="npt-icon-button" aria-label="切换外观">◐</button>
            </div>
        </header>
        <button id="npt-backdrop" type="button" aria-label="关闭导航菜单" tabindex="-1"></button>
        <nav id="npt-navigation" class="npt-sidebar" aria-label="主导航">
            <div class="npt-sidebar-heading"><span>设备管理</span><button id="npt-nav-close" type="button" class="npt-icon-button" aria-label="关闭导航菜单">×</button></div>
            <ul id="npt-menu"></ul>
        </nav>
        <main id="maincontent" class="container" tabindex="-1">
            {% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
            <div class="alert-message warning"><h4>{{ _('No password set!') }}</h4><p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
                {% if (dispatcher.lookup('admin/system/admin')): %}<a class="btn" href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Go to password configuration...') }}</a>{% endif %}
            </div>
            {% endif %}
            {% if (boardinfo.rootfs_type == 'initramfs'): %}
            <div class="alert-message warning"><h4>{{ _('System running in recovery (initramfs) mode.') }}</h4><p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p></div>
            {% endif %}
            <noscript><div class="alert-message warning">{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</div></noscript>
            <div id="tabmenu"></div>
        {% endif %}
