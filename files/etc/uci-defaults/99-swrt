#!/bin/sh
# Apply identity and homepage defaults once; preserve user settings afterwards.
uci set 'system.@system[0].hostname=S-Photonicat1'
uci set luci.main.lang='zh_cn'

# The native Network Panel homepage is first in the LuCI menu.
uci set luci.main.mediaurlbase='/luci-static/apollo'

# Auto mode uses QModem's shared service when present. Do not claim its AT port.
uci set network_panel.main=core
uci set network_panel.main.backend_mode='auto'
uci set network_panel.main.boot_enabled='1'

# QModem's at_tool=0 selects Tom; discovered instances retain shared ubus AT.
uci set qmodem.main.at_tool='0'
# This upstream configuration omits the USB flag while its backend defaults off.
uci set qmodem.main.enable_usb_scan='1'

uci commit system
uci commit luci
uci commit network_panel
uci commit qmodem

for service in wlmb-server swrt-wlmb-battery dockerd ttyd swrt-pcat-manager; do
    [ ! -x "/etc/init.d/$service" ] || "/etc/init.d/$service" enable
done

rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*
exit 0
