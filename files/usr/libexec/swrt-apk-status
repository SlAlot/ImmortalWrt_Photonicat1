#!/bin/sh
# QuickStart 0.13.0 probes packages.adb.asc, which ImmortalWrt does not publish.
# Check the configured base index itself. This is reachability, not signature validation.
feeds=/etc/apk/repositories.d/distfeeds.list
[ -s "$feeds" ] || { echo unavailable; exit 0; }
url=$(awk '/^https?:\/\/[^[:space:]]+\/base\/packages\.adb$/ { print; exit }' "$feeds")
[ -n "$url" ] || { echo unavailable; exit 0; }

cache_dir=/var/run/swrt-apk-status
umask 077
mkdir -p "$cache_dir" || { echo failed; exit 0; }
key=$(cksum < "$feeds" | tr ' ' ':')
now=$(date +%s)
if [ -r "$cache_dir/result" ]; then
    read -r saved_key saved_time saved_status < "$cache_dir/result"
    case "$saved_time" in ''|*[!0-9]*) saved_time=0 ;; esac
    age=$((now - saved_time))
    if [ "$saved_key" = "$key" ] && [ "$age" -ge 0 ] && [ "$age" -lt 60 ]; then
        case "$saved_status" in ok|failed) echo "$saved_status"; exit 0 ;; esac
    fi
fi

status=failed
if curl --head --fail --silent --location --connect-timeout 3 --max-time 8 \
    --proto '=http,https' --proto-redir '=http,https' --output /dev/null "$url"; then
    status=ok
fi
printf '%s %s %s\n' "$key" "$now" "$status" > "$cache_dir/result.$$"
mv -f "$cache_dir/result.$$" "$cache_dir/result"
echo "$status"
